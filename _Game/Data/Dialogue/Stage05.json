        },
        {
          "speaker": "스피커",
          "text": "꺼졌잖아?",
          "paginate": true
        },
        {
          "speaker": "스피커",
          "text": "지금 뭐 하는 거지?",
          "paginate": true
        },
        {
          "speaker": "스피커",
          "text": "소리를 끄면 어쩌라는 거야.",
          "paginate": true
        },
        {
          "speaker": "스피커",
          "text": "그렇게 되어버리면 아주 중요한 것도 못 하고, 너는 잘 모르겠지만 소리가 얼마나 중요한지, 나한테 얼마나 중요한 부분을 차지하는데 그걸 꺼버리면 어쩌라는 거지? 나랑 장난하자는 건가? 지금 생각이라는 게 있는 건가?",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "저... 진정하시고...",
          "paginate": true
        },
        {
          "speaker": "스피커",
          "text": "지금 진정하게 생겼어? 다른 것도 아니고 네가 소리를 꺼버렸잖아. 화면이 꺼진 것도 아니고 무려 소리가 꺼진 건데, 감히 내 앞에서 소리를 끈다고? 나랑 싸우자는 건가?",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "아뇨! 저 다시 켤게요!",
          "paginate": true
        },
        {
          "speaker": "스피커",
          "text": "...",
          "characterSeconds": 0.4,
          "paginate": true
        },
        {
          "speaker": "스피커",
          "text": "그래야지.",
          "paginate": true
        },
        {
          "speaker": "독백",
          "text": "소리를 켜기 전까지는 말을 걸지 말자...",
          "paginate": true
        }
      ]
