          "speaker": "V양",
          "text": "...?!",
          "paginate": true
        },
        {
          "speaker": "조이스틱",
          "text": "같이 놀자! 나가지 마!",
          "paginate": true
        },
        {
          "speaker": "독백",
          "text": "말이 통하지 않는다.",
          "paginate": true
        }
      ]
    },
    {
      "id": "S6_TALK_2",
      "lines": [
        {
          "speaker": "조이스틱",
          "text": "재밌어?",
          "paginate": true
        },
        {
