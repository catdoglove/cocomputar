{
  "sequences": [
    {
      "id": "S2_INTRO",
      "lines": [
        {
          "speaker": "백",
          "text": "이게 아니라 여기라니까?"
        },
        {
          "speaker": "흑",
          "text": "어이, 잠깐만 그만 좀 밀어봐! 누가 왔잖아!"
        },
        {
          "speaker": "백",
          "text": "아, 왜 또.. 어? 어라?"
        },
        {
          "speaker": "V양",
          "text": "저기.. 전 여기 처음인데.. 그.."
        },
        {
          "speaker": "흑",
          "text": "아니, 이게 누구야! 진짜 반갑잖아!"
        },
        {
          "speaker": "백",
          "text": "반갑잖아!"
        },
        {
          "speaker": "V양",
          "text": "저.. 저기요, 그렇게 갑자기 가까이 오시면.."
        },
        {
          "speaker": "흑",
          "text": "이거 환영회라도 해야 하는 거 아니야?"
        },
        {
          "speaker": "백",
          "text": "그런 거 아니야?"
        },
        {
          "speaker": "V양",
          "text": "환영회라니요.. 괜찮아요, 전 그런 거 필요 없는데.."
        },
        {
          "speaker": "V양",
          "text": "혹시 나가는 길은 안 알려주시나요?"
        },
        {
          "speaker": "흑",
          "text": "그 전에 일단 내 이야기부터 들어봐!"
        },
        {
          "speaker": "백",
          "text": "아니, 내 이야기부터 들어줘야지!"
        },
        {
          "speaker": "흑",
          "text": "내가 먼저 말하려고 했거든?"
        },
        {
          "speaker": "백",
          "text": "내가 먼저 발견했거든!"
        },
        {
          "speaker": "V양",
          "text": "저, 저기.. 잠깐만요.."
        },
        {
          "speaker": "V양",
          "text": "한 사람씩 말해줘요. 정신없단 말이에요.."
        },
        {
          "speaker": "흑",
          "text": "아, 미안 미안!"
        },
        {
          "speaker": "백",
          "text": "미안하다구."
        },
        {
          "speaker": "V양",
          "text": "그래서.. 아까 무슨 말씀을 하려고 하신 거예요?"
        },
        {
          "speaker": "흑",
          "text": "글쎄, 우리가 보관하고 있었던 중요한 열쇠를 잃어버렸지 뭐야!"
        },
        {
          "speaker": "백",
          "text": "그랬지 뭐야!"
        },
        {
          "speaker": "V양",
          "text": "네? 열쇠요?"
        },
        {
          "speaker": "백",
          "text": "휴지통에도 없어!"
        },
        {
          "speaker": "흑",
          "text": "그래, 휴지통까지 샅샅이 뒤졌는데 없다고!"
        },
        {
          "speaker": "V양",
          "text": "어.. 휴지통이요?"
        },
        {
          "speaker": "백",
          "text": "어디에도 없어!"
        },
        {
          "speaker": "흑",
          "text": "있는 거라곤 쓸데없는 그림뿐이야."
        },
        {
          "speaker": "백",
          "text": "그림뿐이지!"
        },
        {
          "speaker": "V양",
          "text": "그림이요..? 저.. 제가 한번 봐도 될까요?"
        },
        {
          "speaker": "흑",
          "text": "에이, 그게 뭐 단서겠어? 어디 둔 거 같긴 한데.."
        },
        {
          "speaker": "백",
          "text": "그러게.. 어디 뒀더라?"
        },
        {
          "speaker": "독백",
          "text": "일단 두고 그림이라는 걸 살펴보자"
        }
      ]
    },
    {
      "id": "S2_P1_PRE",
      "lines": [
        {
          "speaker": "흑",
          "text": "그 전의 것은 어디다 뒀어?"
        },
        {
          "speaker": "백",
          "text": "그것도 기억이 안나는데."
        },
        {
          "speaker": "흑",
          "text": "도대체 기억하는 건 뭐야?!"
        },
        {
          "speaker": "백",
          "text": "음.. 시간?"
        },
        {
          "speaker": "V양",
          "text": "어서 열쇠를 찾아보자."
        }
      ]
    },
    {
      "id": "S2_P1_OK",
      "lines": [
        {
          "speaker": "V양",
          "text": "저기.. 이거 찾았어요. 열쇠 맞죠..?"
        },
        {
          "speaker": "흑",
          "text": "야! 여기 있었잖아! 고마워!"
        },
        {
          "speaker": "백",
          "text": "그러게, 그랬네! 고마워!"
        },
        {
          "speaker": "V양",
          "text": "가까이 오지는 마시고.."
        },
        {
          "speaker": "V양",
          "text": "그래도 찾아다 줄 수 있어서 다행이에요."
        },
        {
          "speaker": "흑",
          "text": "다행이지 뭐 잠깐 근데.."
        },
        {
          "speaker": "V양",
          "text": "다른 문제라도 있어요..?"
        },
        {
          "speaker": "흑",
          "text": "잠깐, 이것 좀 봐봐! 네 것만 있고 내 건 없잖아!"
        },
        {
          "speaker": "백",
          "text": "뭐 어때? 난 처음부터 알고 있었어."
        },
        {
          "speaker": "V양",
          "text": "에..? 없다고요? 뭐가 없다는 말씀이세요..?"
        },
        {
          "speaker": "흑",
          "text": "알고 있는데 가만히 있었어? 내 열쇠는 없다고!"
        },
        {
          "speaker": "백",
          "text": "그냥 하나로 있어도 되잖아."
        },
        {
          "speaker": "흑",
          "text": "안돼! 내것도 있어야해!"
        },
        {
          "speaker": "V양",
          "text": "그... 잠시만요. 열쇠가 하나 더 있다는 말씀이시죠?"
        },
        {
          "speaker": "흑",
          "text": "그래! 분명 내 열쇠도 있어야해 두개가 세트거든."
        },
        {
          "speaker": "백",
          "text": "세트긴해."
        },
        {
          "speaker": "V양",
          "text": "아, 네.. 세트인 건 알겠는데요..!"
        },
        {
          "speaker": "V양",
          "text": "너무 흥분하지 마시구.. 일단 차분하게 생각해 봐요."
        },
        {
          "speaker": "흑",
          "text": "으으, 내 열쇠는 어디로 간 거야?"
        },
        {
          "speaker": "백",
          "text": "에휴.. 찾아봐야겠네.. 도와줄거지?"
        },
        {
          "speaker": "V양",
          "text": "아.. 네 일단 노력해볼게요."
        }
      ]
    },
    {
      "id": "S2_P2_PRE",
      "lines": [
        {
          "speaker": "흑",
          "text": "그래서 어떤 시간을 기억하고 있는데?"
        },
        {
          "speaker": "백",
          "text": "과거이지 않을까?"
        },
        {
          "speaker": "흑",
          "text": "..과거에 뭐가 있었지?"
        },
        {
          "speaker": "백",
          "text": "..가족?"
        },
        {
          "speaker": "독백",
          "text": "무슨 말을 하는지 모르겠다."
        }
      ]
    },
    {
      "id": "S2_P2_OK",
      "lines": [
        {
          "speaker": "흑",
          "text": "드디어 내 열쇠도 찾았다! 고마워!"
        },
        {
          "speaker": "백",
          "text": "안 찾아도 되는데 고마워."
        },
        {
          "speaker": "흑",
          "text": "어휴, 그나저나 여긴 정말 평화로워."
        },
        {
          "speaker": "백",
          "text": "맞네, 평화롭네."
        },
        {
          "speaker": "V양",
          "text": "저기.. 두 분.. 열쇠도 찾았고.. 이제 나가는 문을 알려주실 수 있나요?"
        },
        {
          "speaker": "흑",
          "text": "나가는 문? 글쎄다.. 굳이 위험하게 나가는 법이 있나?"
        },
        {
          "speaker": "백",
          "text": "나가는 법이 있나?"
        },
        {
          "speaker": "V양",
          "text": "네..? 없다고요..? 하지만 열쇠는 그럼.."
        },
        {
          "speaker": "흑",
          "text": "아~ 그건 우리 개인적인 물건이고. 봐봐, 여긴 맛있는 아이콘도 많고, 악성 코드도 없고.."
        },
        {
          "speaker": "백",
          "text": "바깥은 위험하다구."
        },
        {
          "speaker": "V양",
          "text": "그건 저도 알지만 그래도 저는 원래 장소로 돌아가야 할 것 같아요."
        },
        {
          "speaker": "흑",
          "text": "원래 장소로 돌아가고 싶은 거야, 돌아가야 한다는 거야?"
        },
        {
          "speaker": "V양",
          "text": "그.. 그건"
        },
        {
          "speaker": "백",
          "text": "흐음.."
        },
        {
          "speaker": "흑",
          "text": "그래도 정 여기를 벗어나고 싶다면 말이지."
        },
        {
          "speaker": "백",
          "text": "들은 게 있단 말이지."
        },
        {
          "speaker": "흑",
          "text": "이전 화면에 있었던 폴더 영감 기억나?"
        },
        {
          "speaker": "백",
          "text": "기억나?"
        },
        {
          "speaker": "V양",
          "text": "아 네"
        },
        {
          "speaker": "흑",
          "text": "그 분이 나가는 법 알려주지 않았어?"
        },
        {
          "speaker": "백",
          "text": "그러지 않았어?"
        },
        {
          "speaker": "V양",
          "text": "네 기억나요. 오래된 폴더를 꺼내주셨죠."
        },
        {
          "speaker": "흑",
          "text": "아마 여기도 그거랑 비슷한 게 있지 않을까?"
        },
        {
          "speaker": "백",
          "text": "않을까?"
        },
        {
          "speaker": "V양",
          "text": "음 일단 찾아볼게요."
        },
        {
          "speaker": "흑",
          "text": "심심하니까 언제든지 와!"
        },
        {
          "speaker": "백",
          "text": "또 와!"
        }
      ]
    },
    {
      "id": "S2_TULIP",
      "lines": [
        {
          "speaker": "흑",
          "text": "우와 꽃이다 오랜만이네"
        },
        {
          "speaker": "백",
          "text": "그러게"
        },
        {
          "speaker": "V양",
          "text": "언제 꽃 보셨나요?"
        },
        {
          "speaker": "흑",
          "text": "너무 오래되어서 기억도 안 나"
        },
        {
          "speaker": "백",
          "text": "맞아 기억이 안 나"
        },
        {
          "speaker": "흑",
          "text": "음 향기 좋네"
        },
        {
          "speaker": "백",
          "text": "그러네"
        },
        {
          "speaker": "V양",
          "text": "..향기가 나나요?"
        },
        {
          "speaker": "흑",
          "text": "당연하지"
        },
        {
          "speaker": "백",
          "text": "너도 맡아볼래?"
        },
        {
          "speaker": "나레이션",
          "text": "꽃다발이 얼굴 가까이 다가와서 맡았다."
        },
        {
          "speaker": "V양",
          "text": "..? 아무 냄새도 안 나는데?"
        },
        {
          "speaker": "흑",
          "text": "코가 막혔나 보지"
        },
        {
          "speaker": "독백",
          "text": "하긴 냄새가 날 리가 없다. 여긴 꿈일 수도 있고"
        },
        {
          "speaker": "백",
          "text": "아직도 ■이라고 생각해?",
          "glitchWords": [
            "■"
          ]
        },
        {
          "speaker": "V양",
          "text": "네?"
        },
        {
          "cmd": "glitch",
          "seconds": 2.0
        },
        {
          "cmd": "wait",
          "seconds": 1.0
        },
        {
          "speaker": "흑",
          "text": "음~ 향기 좋다."
        },
        {
          "speaker": "백",
          "text": "저쪽에 두자."
        },
        {
          "speaker": "흑",
          "text": "이번엔 까먹지 말자!"
        },
        {
          "speaker": "백",
          "text": "그러자!"
        },
        {
          "speaker": "독백",
          "text": "방금 뭐였을까.."
        }
      ]
    },
