{
  "sequences": [
    {
      "id": "S7_TALK_1",
      "lines": [
        {
          "speaker": "플로피디스크",
          "text": "하하! 반가운 얼굴인데, 아닌가?",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...안녕하세요.",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "그래그래. 이런 곳엔 무슨 일로 찾아온 건가?",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "그게, 제가 헤매고 있어서요.",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "흐음. 그래서 무작정 돌아다니고 있는 거고?",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "일단... 그렇죠, 뭐.",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "호오! 생각보다 당찬 아가씨로군!",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "아니에요. 전 성격이 소극적이라...",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "음? 내가 보기엔 그렇지 않은 것 같은데?",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...저에 대해 뭘 아신다고...",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "하하! 말이 그렇지!",
          "paginate": true
        },
        {
          "speaker": "독백",
          "text": "웃음소리가 너무 크다.",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "난 봐야 할 게 많다네.",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "길이라면 스스로 개척할 줄 알아야지.",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "안 그런가?",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "음... 조금 도와주실 수 없나요?",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "거참 까다로운 아가씨구만!",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "그럼 이것 좀 아가씨가 대신 봐주게!",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "네? 갑자기요?",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "이걸 도와주면 내가 봐줄 수도 있지.",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "아닐 수도 있고! 하하!",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "으...",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "사양 말고 편하게 보라고!",
          "paginate": true
        }
      ]
    },
    {
      "id": "S7_TALK_2",
      "lines": [
        {
          "speaker": "플로피디스크",
          "text": "그래서, 아가씨.",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "네?",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "아직도 사탕 좋아하는가?",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "어... 전 처음부터 좋아하지 않았는데요?",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "엥? 아니라고?",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "하하! 그거 참 아쉽군!",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...하하.",
          "paginate": true
        }
      ]
    },
    {
      "id": "S7_TALK_3",
      "lines": [
        {
          "speaker": "플로피디스크",
          "text": "아까부터 뭘 그리 쳐다보나!",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "뭘요?",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "혹시 내 얼굴에 뭐라도 묻었나?",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "에? 아니요!",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "아니라고?",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "시선이 느껴졌는데?",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "저 진짜 안 봤어요!",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "하하! 농담일세, 농담!",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...",
          "paginate": true
        }
      ]
    },
    {
      "id": "S7_DOOR",
      "lines": [
        {
          "speaker": "플로피디스크",
          "text": "하하! 폴더 말한 게 진짜로군!",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "네? 그분 아시나요?",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "당연히 알지!",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "내가 친구도 못 알아보는 멍청이로 보이나?",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "그건 아니지만...",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "제가 알기로는 여기서 서로 만나지 못한다는 이야기를 들었는데...",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "당연하지! 우리는 오랫동안 안 봐도 알 거 다 안다네!",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "언제 만났나요?",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "아마 한 578년?",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "허억...",
          "paginate": true,
          "expressionId": "surprised"
        },
        {
          "speaker": "플로피디스크",
          "text": "아직 때가 안 된 걸세.",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "때가 되면 자연스레 만나는 법.",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "아가씨는 걱정할 게 아니라구! 하하!",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "그렇군요...",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "친구분을 못 만나시니 아쉬운 일이에요.",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "걱정해 주는 건가? 하하! 고맙군!",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "아가씨가 착해서 말해주는 건데.",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "모든 파일을 믿지 말게나.",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "때로는 무서운 존재가 있다네.",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "아직까지 못 본 것 같아요.",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "그건 아가씨 생각이고! 하하!",
          "paginate": true
        },
        {
          "speaker": "독백",
          "text": "알쏭달쏭한 말이다...",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "난 할 일이 아~주 많아! 아가씨는 이제 알아서 볼일 보라고!",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "넵, 알겠습니다.",
          "paginate": true
        },
        {
          "speaker": "플로피디스크",
          "text": "하하! 잘 가게나!",
          "paginate": true
        }
      ]
    },
    {
      "id": "S7_AFTER_DOOR",
      "lines": [
        {
          "speaker": "플로피디스크",
          "text": "(흥얼흥얼)",
          "paginate": true
        },
        {
          "speaker": "독백",
          "text": "바빠 보인다.",
          "paginate": true
        }
      ]
    }
  ]
}