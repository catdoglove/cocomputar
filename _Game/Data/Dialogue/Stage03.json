{
  "sequences": [
    {
      "id": "S3_INTRO_A",
      "lines": [
        {
          "speaker": "그림",
          "text": "잠깐, 지금 뭐 하는 거야?"
        },
        {
          "speaker": "V양",
          "text": "에...? 저, 저요?"
        },
        {
          "speaker": "그림",
          "text": "그래, 너. 지금 뭐 누르려고 했어?"
        },
        {
          "speaker": "V양",
          "text": "아... 그냥 이거 한번 눌러보려고요..."
        },
        {
          "speaker": "그림",
          "text": "...뭔지도 모르면서?"
        }
      ]
    },
    {
      "id": "S3_INTRO_B",
      "lines": [
        {
          "speaker": "V양",
          "text": "저기.."
        },
        {
          "speaker": "그림",
          "text": "응? 뭐야 언제 왔어?"
        },
        {
          "speaker": "V양",
          "text": "옆에 있는 파일 눌러봐도 되나요?"
        },
        {
          "speaker": "그림",
          "text": "...뭔지도 모르면서?"
        }
      ]
    },
    {
      "id": "S3_INTRO_COMMON",
      "lines": [
        {
          "speaker": "V양",
          "text": "네...? 아, 그게..."
        },
        {
          "speaker": "그림",
          "text": "하아... 아무거나 함부로 누르면 안 되는데."
        },
        {
          "speaker": "그림",
          "text": "잠깐 이리 줘 봐."
        },
        {
          "speaker": "V양",
          "text": "아, 네...?"
        },
        {
          "speaker": "그림",
          "text": "그냥 막 설치하면 안 된다고."
        },
        {
          "speaker": "그림",
          "text": "잘못하면 바이러스 걸릴 수도 있어."
        },
        {
          "speaker": "V양",
          "text": "그, 그런가요...?"
        },
        {
          "speaker": "그림",
          "text": "잠깐만."
        },
        {
          "speaker": "V양",
          "text": "..."
        },
        {
          "speaker": "그림",
          "text": "음.. 여기 중에 바이러스 파일을 심어놓은 게 있군."
        },
        {
          "speaker": "그림",
          "text": "역시 오래되어서 그런가."
        },
        {
          "speaker": "V양",
          "text": "그렇군요.."
        },
        {
          "speaker": "그림",
          "text": "그러니까 모르는 건 함부로 건드리면 안 된다는 소리야."
        },
        {
          "speaker": "V양",
          "text": "아... 네에..."
        },
        {
          "speaker": "그림",
          "text": "...됐다."
        },
        {
          "speaker": "그림",
          "text": "자, 여기. 확인했으니까 이제 괜찮을 거야."
        },
        {
          "speaker": "V양",
          "text": "아...! 감사합니다."
        },
        {
          "speaker": "그림",
          "text": "대신 다른 건 절대 건드리지 마. 알겠지?"
        },
        {
          "speaker": "V양",
          "text": "네."
        },
        {
          "speaker": "그림",
          "text": "모르는 파일 함부로 설치하지 마. 말도 걸지 말고."
        },
        {
          "speaker": "V양",
          "text": "음..근데 그쪽도 모르는 파일인데.."
        },
        {
          "speaker": "그림",
          "text": "..나는 예외야"
        },
        {
          "speaker": "V양",
          "text": "그.. 그렇군요."
        },
        {
          "speaker": "그림",
          "text": "암튼 조심하라고 아가씨."
        }
      ]
    },
    {
      "id": "S3_LOOP_A",
      "lines": [
        {
          "speaker": "그림",
          "text": "중얼중얼.."
        },
        {
          "speaker": "독백",
          "text": "뭔가에 집중하고 있는 거 같다."
        }
      ]
    },
    {
      "id": "S3_P1_OK",
      "lines": [
        {
          "speaker": "그림",
          "text": "음?"
        },
        {
          "speaker": "V양",
          "text": "저 아무거나 건들지 말라 했는데.."
        },
        {
          "speaker": "그림",
          "text": "근데?"
        },
        {
          "speaker": "V양",
          "text": "뭐가 설치되었어요."
        },
        {
          "speaker": "그림",
          "text": "뭐야? 이리 줘봐!!"
        },
        {
          "speaker": "독백",
          "text": "으..어쩌지..?"
        },
        {
          "speaker": "그림",
          "text": "...아아, 다행이네"
        },
        {
          "speaker": "그림",
          "text": "이상한 게 설치된 건 아니야."
        },
        {
          "speaker": "V양",
          "text": "에... 정말요?"
        },
        {
          "speaker": "그림",
          "text": "그래. 아까 내가 준 프로그램이 업데이트된 거였어."
        },
        {
          "speaker": "그림",
          "text": "딱히 문제는 없어 보여."
        },
        {
          "speaker": "V양",
          "text": "휴.. 다행이네요."
        },
        {
          "speaker": "그림",
          "text": "근데 말이야."
        },
        {
          "speaker": "V양",
          "text": "네?"
        },
        {
          "speaker": "그림",
          "text": "분명 아무거나 건드리지 말라고 했는데."
        },
        {
          "speaker": "그림",
          "text": "아가씨는 호기심이 꽤 많은가 보지?"
        },
        {
          "speaker": "V양",
          "text": "으.. 죄송해요.."
        },
        {
          "speaker": "그림",
          "text": "뭐, 됐어. 덕분에 프로그램도 업데이트됐으니까."
        },
        {
          "speaker": "그림",
          "text": "결과적으로 나쁜 일은 아니네."
        },
        {
          "speaker": "V양",
          "text": "그럼 다행이네요!"
        },
        {
          "speaker": "그림",
          "text": "그렇다고 다음에도 막 누르라는 뜻은 아니고."
        },
        {
          "speaker": "V양",
          "text": "앗 네.. 그렇죠.."
        },
        {
          "speaker": "그림",
          "text": "그나저나 아가씨."
        },
        {
          "speaker": "그림",
          "text": "뭐 찾고 있었어?"
        },
        {
          "speaker": "V양",
          "text": "그게.. 나가는 법을 찾고 있는데 아직 모르겠어서.."
        },
        {
          "speaker": "그림",
          "text": "흐음.. 나가는 법이라.."
        },
        {
          "speaker": "그림",
          "text": "나도 여기서 나가본 적은 없어서 말이지."
        },
        {
          "speaker": "V양",
          "text": "그렇군요..."
        },
        {
          "speaker": "그림",
          "text": "하지만 내 생각이 맞다면, 저 파일이 도움이 될지도 모르겠는데."
        },
        {
          "speaker": "V양",
          "text": "저 파일이요?"
        },
        {
          "speaker": "그림",
          "text": "저쪽에 있는 오래된 파일 말이야."
        },
        {
          "speaker": "그림",
          "text": "확실하진 않지만."
        },
        {
          "speaker": "그림",
          "text": "워낙 오래된 파일이라 나도 잘 열어보진 않았거든."
        },
        {
          "speaker": "V양",
          "text": "아아..."
        },
        {
          "speaker": "그림",
          "text": "그래도 필요한 건 오래된 것에 있다고 했으니까."
        },
        {
          "speaker": "V양",
          "text": "누가요?"
        },
        {
          "speaker": "그림",
          "text": "음? 아마 아가씨도 만나봤을 텐데."
        },
        {
          "speaker": "그림",
          "text": "폴더 그 양반이 그러더라고."
        },
        {
          "speaker": "V양",
          "text": "그렇군요... 알려주셔서 감사합니다."
        },
        {
          "speaker": "그림",
          "text": "그럼 난 내 볼일 볼 테니 나머지는 알아서 해보라고, 아가씨."
        },
        {
          "speaker": "V양",
          "text": "아 네 감사합니다!"
        },
        {
          "speaker": "그림",
          "text": "아 그리고.."
        },
        {
          "speaker": "그림",
          "text": "다음부터는 아무거나 함부로 누르지 말도록 해."
        },
        {
          "speaker": "V양",
          "text": "헤헤 그럴게요!"
        },
        {
          "speaker": "그림",
          "text": "(중얼) 성격이 많이 밝아졌군.",
          "style": "mutter"
        },
        {
          "speaker": "V양",
          "text": "?"
        }
      ]
    },
    {
      "id": "S3_LOOP_B",
      "lines": [
        {
          "speaker": "그림",
          "text": "근데 되게 시끄럽지 않았어?"
        },
        {
          "speaker": "V양",
          "text": "누가요?"
        },
        {
          "speaker": "그림",
          "text": "쌍둥이들 말이야"
        },
        {
          "speaker": "V양",
          "text": "아 맞아요!"
        },
        {
          "speaker": "V양",
          "text": "그래도 도움을 받았어요"
        },
        {
          "speaker": "그림",
          "text": "도움? 걔네들이?"
        },
        {
          "speaker": "그림",
          "text": "예전에 내 그림파일을 맘대로 가져가 돌려놓지도 않는 그놈들이?"
        },
        {
          "speaker": "그림",
          "text": "생각하니까 열받네 내가 좋아하는 것 중에 하나거든"
        },
        {
          "speaker": "V양",
          "text": "혹시 풍경화였나요?"
        },
        {
          "speaker": "그림",
          "text": "..아직도 있어?"
        },
        {
          "speaker": "V양",
          "text": "하하.."
        }
      ]
    },
    {
      "id": "S3_LOOP_C",
      "lines": [
        {
          "speaker": "그림",
          "text": "도움이 되었나?"
        },
        {
          "speaker": "V양",
          "text": "네. 정말 감사드려요."
        },
        {
          "speaker": "V양",
          "text": "덕분에 이곳을 벗어날 수 있을 거란 희망이 생겼어요."
        },
        {
          "speaker": "그림",
          "text": "그래. 그럼 이만 가봐."
        },
        {
          "speaker": "V양",
          "text": "..다시 만날 수 있을까요?"
        },
        {
          "speaker": "그림",
          "text": "그건 네 몫이지."
        },
        {
          "speaker": "V양",
          "text": "그렇군요.."
        },
        {
          "speaker": "V양",
          "text": "다음에도 이렇게 도와주실 건가요?"
        },
        {
          "speaker": "그림",
          "text": "글쎄. 그땐 네가 날 도와줘야 할지도 모르지."
        },
        {
          "speaker": "그림",
          "text": "물론 네가 그럴 수 있다면 말이야."
        },
        {
          "speaker": "V양",
          "text": "네. 그 말 기억해 둘게요."
        },
        {
          "speaker": "그림",
          "text": "마음대로 해. 그때까지 잘 지내든가."
        },
        {
          "speaker": "V양",
          "text": "넵!ㅎㅎ"
        }
      ]
    },
    {
      "id": "S3_PAST",
      "lines": [
        {
          "speaker": "어린그림",
          "text": "넌 뭐야?"
        },
        {
          "speaker": "어린그림",
          "text": "여긴 아무도 못 오는데?"
        },
        {
          "speaker": "V양",
          "text": "아..나는.."
        },
        {
          "speaker": "V양",
          "text": "헤매고 있는 거 같아."
        },
        {
          "speaker": "어린그림",
          "text": "헤맨다고? 그럼 길을 잃은 거네!"
        },
        {
          "speaker": "어린그림",
          "text": "그렇다면 어른한테 도와달라고 하면 돼!"
        },
        {
          "speaker": "V양",
          "text": "하지만.. 여긴 어른이 없는걸."
        },
        {
          "speaker": "어린그림",
          "text": "걱정하지 마! 내가 봤어!"
        },
        {
          "speaker": "어린그림",
          "text": "저쪽으로 어른들이 가는 걸 봤거든."
        },
        {
          "speaker": "V양",
          "text": "아 그래? 고마워 한번 가볼게."
        },
        {
          "speaker": "어린그림",
          "text": "응! 잘 가!"
        }
      ]
    },
    {
      "id": "S3_PAST_LOOP",
      "lines": [
        {
          "speaker": "어린그림",
          "text": "룰루룰루~"
        },
        {
          "speaker": "독백",
          "text": "즐거워 보인다."
        }
      ]
    },
    {
      "id": "S3_FILM_FIRST",
      "lines": [
        {
          "speaker": "그림",
          "text": "아가씨."
        },
        {
          "speaker": "V양",
          "text": "네?"
        },
        {
          "speaker": "그림",
          "text": "지금뭐해?"
        },
        {
          "speaker": "그림",
          "text": "또 뭐 누르려고?"
        },
        {
          "speaker": "V양",
          "text": "그게 아니고.."
        }
      ]
    }
  ]
}
