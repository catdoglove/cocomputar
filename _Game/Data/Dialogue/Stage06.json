        },
        {
          "speaker": "V양",
          "text": "...",
          "paginate": true
        },
        {
          "speaker": "조이스틱",
          "text": "그보다 더?",
          "paginate": true
        },
        {
          "speaker": "조이스틱",
          "text": "아니면 그보다 더 적게?",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...",
          "paginate": true
        },
        {
          "speaker": "조이스틱",
          "text": "네가 즐거우면.",
          "paginate": true
        },
        {
          "speaker": "조이스틱",
          "text": "나도 좋아!",
          "paginate": true
        },
        {
          "speaker": "조이스틱",
          "text": "같이하자! 계속!",
          "paginate": true
        },
