{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "623165c6d9554bd1a4d0fd78f5717f78",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "CRT",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 306.2221984863281,
            "y": 181.77772521972656,
            "width": 208.00003051757812,
            "height": 432.44451904296875
        }
    },
    "m_Slots": [
        {
            "m_Id": "382c57c33193472a8b4d787a5d01e46e"
        },
        {
            "m_Id": "52901f72a10a48b6822e3cd75f35e288"
        },
        {
            "m_Id": "965cca74adc747398d92f0878dc18b87"
        },
        {
            "m_Id": "ab95b71f39604d8494d561d3be607468"
        },
        {
            "m_Id": "726bfe33669a43908cee878c6277d908"
        },
        {
            "m_Id": "d17ba06115114419bd1fb804e5a08541"
        }
    ],
    "synonyms": [
        "tex2d"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_TextureType": 0,
    "m_NormalMapSpace": 0,
    "m_EnableGlobalMipBias": true,
    "m_MipSamplingMode": 0,
    "m_SourceType": 1,
    "m_FunctionName": "CRTScreen",
    "m_FunctionSource": "",
    "m_FunctionBody": "float2 q=UV*2-1;\nfloat2 uv=.5+.5*q*(1+dot(q,q)*Shape.y);\nuv.x+=sin(floor(uv.y*35)+_Time.y*37)*.025*Light.w;\nfloat2 off=float2(Shape.w*Intensity+.015*Light.w,0);\nfloat3 c=SAMPLE_TEXTURE2D(Texture.tex,Texture.samplerstate,uv).rgb;\nc.r=SAMPLE_TEXTURE2D(Texture.tex,Texture.samplerstate,uv+off).r;\nc.b=SAMPLE_TEXTURE2D(Texture.tex,Texture.samplerstate,uv-off).b;\nfloat3 glow=0;\nfor(int x=-1;x<=1;x++) for(int y=-1;y<=1;y++) glow+=SAMPLE_TEXTURE2D(Texture.tex,Texture.samplerstate,uv+float2(x,y)*.0025).rgb;\nc+=max(glow/9-.35,0)*Light.y*Intensity;\nfloat scanPhase=frac(UV.y*_ScreenParams.y/3.0);\nfloat scanBand=smoothstep(.45,.65,scanPhase)*(1-smoothstep(.85,1.0,scanPhase));\nc*=1-saturate(Shape.x*3)*saturate(Intensity)*scanBand;\nc*=1-Shape.z*Intensity*dot(q,q)*.55;\nfloat grain=frac(sin(dot(uv,float2(12.9898,78.233))+_Time.y*53)*43758.5453)-.5;\nc+=(grain*Light.x+sin(_Time.y*47)*.003)*Intensity;\nc=lerp(c,float3(dot(c,float3(.36,.5,.14))*1.2,dot(c,float3(.3,.5,.15)),dot(c,float3(.18,.32,.1))),Light.z);\nc+=grain*.3*Light.w;\nfloat inside=step(0,uv.x)*step(uv.x,1)*step(0,uv.y)*step(uv.y,1);\nRGBA=float4(max(c,0)*inside,1);"
}

