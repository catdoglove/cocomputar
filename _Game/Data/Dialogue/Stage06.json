          "paginate": true
        },
        {
          "speaker": "조이스틱",
          "text": "좋아! 좋아! 좋아!",
          "paginate": true
        },
        {
          "speaker": "독백",
          "text": "...뭐가 그렇게 좋을까?",
          "paginate": true
