          "text": "안 돼! 안 돼!",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "뭐가 안 된다는 말씀이세요?",
          "paginate": true
        },
        {
          "speaker": "조이스틱",
          "text": "안 돼 안 돼 안 돼 안 돼 안 돼 안 돼 안 돼 안 돼 안 돼 안 돼 안 돼 안 돼 안 돼 안 돼 안 돼 안 돼 안 돼 안 돼 안 돼 안 돼!!",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "치... 침착하세요!",
          "paginate": true
        },
        {
          "speaker": "조이스틱",
          "text": "가지 마.",
          "paginate": true
        },
        {
          "speaker": "조이스틱",
          "text": "남아 놀자? 나랑?",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "저... 무슨 말씀이신지...",
          "paginate": true
        },
        {
          "speaker": "조이스틱",
          "text": "헤헤. 계속 놀자!",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...",
          "paginate": true
        }
      ]
    },
