{
  "sequences": [
    {
      "id": "S9_D1",
      "lines": [
        {
          "speaker": "열쇠",
          "text": "...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "여기까지 왔구나.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...?",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "절 아시나요?",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "알고말고.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "하지만 넌 우리를 모르겠지.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "그럴 수밖에.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...저는 아직도 혼란스러워요.",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "여기가 어딘지도, 왜 제가 여기 있는지도...",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "걱정하지 마.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "이제 거의 다 왔으니까.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...정말요?",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "그래.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "하지만 그러기 위해선...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "아직 부족한 게 하나 있어.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "부족한 거요?",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "정말 같으면서도 다르구나.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...네?",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "하긴...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "이제는 그 아이를 놓아줄 때도 되었지.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...그 아이요?",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "아, 아니야.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "지금 중요한 이야기는 아니니까.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "미안하구나.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "더 많은 걸 알려줄 수 있으면 좋을 텐데.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "아니에요.",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "그래도 저를 도와주시려고 하잖아요.",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "그것만으로도 감사해요.",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "우리들은 그러기 위해 존재하니까.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...네?",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "그보다 부탁 하나만 해도 될까?",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "부탁이요?",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "그래.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "내가 마지막으로 보고 싶은 게 있거든.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "혹시 찾아줄 수 있겠니?",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "네! 제가 할 수 있는 거라면요.",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "고맙구나.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "어려운 건 아니야.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "그냥 사진 한 장이야.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "사진이요?",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "그래.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "그런데 난 직접 찾아갈 수가 없어서.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...왜요?",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "내게는 그럴 권한이 없거든.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "하지만 넌 할 수 있어.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "너만이 할 수 있는 일이야.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "걱정하지 마세요.",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "제가 꼭 찾아드릴게요!",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "그래.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "기다리고 있을게.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        }
      ]
    },
    {
      "id": "S9_D2",
      "lines": [
        {
          "speaker": "열쇠",
          "text": "...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "다들 그립구나.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...다른 분들이요?",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "그래.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "참 오랫동안 보지 못했거든.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "그런데 궁금한 게 있어요.",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "응?",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "왜 다들 서로 만나지 못하는 거예요?",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "다른 분들도 비슷한 말씀을 하셨어요.",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "그러면 규칙에 어긋나니까.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "규칙이요?",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "그래.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "우리에겐 각자의 자리가 있어.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "머물러야 할 곳도, 해야 할 일도...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "모두 정해져 있지.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "그렇군요.",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        }
      ]
    },
    {
      "id": "S9_D3",
      "lines": [
        {
          "speaker": "열쇠",
          "text": "그러고 보니...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "게임기는 만나봤니?",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "네, 만나긴 했는데...",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "상태가 별로 좋아 보이지 않았어요.",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "예전에는 안 그랬는데.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "네?",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "그럼 어쩌다가 그렇게 된 거예요?",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "알 수 없는 프로그램에 감염되었어.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "그 뒤로는 말을 제대로 잇지 못하더구나.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "자꾸 횡설수설하고...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...그랬군요.",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "그래도 착한 아이야.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "그저 예전처럼 놀고 싶은 것뿐일 텐데.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "안타깝네요.",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "걱정해 줘서 고마워.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "나도 언젠가는 원래대로 돌아올 거라고 믿고 있어.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "저도 그랬으면 좋겠어요.",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "하하.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "너 정말 빈말을 잘하는구나?",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...!",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "아, 아니에요!",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "진심으로 한 말인데요!",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "알아, 알아.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "그냥 장난 좀 쳐봤어.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "그것도 너만의 매력이니까.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "아이참...!",
          "portraitKey": "portrait_v",
          "paginate": true
        }
      ]
    },
    {
      "id": "S9_FINAL",
      "lines": [
        {
          "speaker": "열쇠",
          "text": "...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "찾아줬구나.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "고마워.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "이 사진이 맞나요?",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "그래.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "바로 이거야.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "그런데 이 사진은...",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "그래.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "너도 알겠지?",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...네.",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "...",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "가기 전에 마지막으로 보고 싶었어.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...",
          "portraitKey": "portrait_v",
          "paginate": true
        },
        {
          "speaker": "열쇠",
          "text": "정말 오랜만이구나.",
          "portraitKey": "portrait_key_special",
          "paginate": true
        },
        {
          "speaker": "열쇠",
