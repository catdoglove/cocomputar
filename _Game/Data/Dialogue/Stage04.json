{
  "sequences": [
    {
      "id": "S4_INTRO",
      "lines": [
        {
          "cmd": "sfx",
          "soundKey": "sfx_startle"
        },
        {
          "speaker": "메모",
          "text": "왁!"
        },
        {
          "speaker": "V양",
          "text": "아이, 깜짝이야!"
        },
        {
          "speaker": "메모",
          "text": "하하! 놀랐어?"
        },
        {
          "speaker": "V양",
          "text": "무.. 뭐예요?"
        },
        {
          "speaker": "메모",
          "text": "엥? 반응이 왜 이래? 예전에는 좋아하지 않았어?"
        },
        {
          "speaker": "V양",
          "text": "하아.. 저는 처음 뵈는데요."
        },
        {
          "speaker": "메모",
          "text": "아, 내가 착각했나 봐."
        },
        {
          "speaker": "메모",
          "text": "예전에 봤던 아이랑 비슷하거든."
        },
        {
          "speaker": "V양",
          "text": "..예전에 봤던 아이요?"
        },
        {
          "speaker": "메모",
          "text": "물론 너보다 더 어렸지만"
        },
        {
          "speaker": "메모",
          "text": "근데 지금 보니 좀 다르네! 착각해서 미안!"
        },
        {
          "speaker": "V양",
          "text": "아니에요.. 사실 저도 좀 지쳐서.."
        },
        {
          "speaker": "메모",
          "text": "지쳐? 왜?"
        },
        {
          "speaker": "V양",
          "text": "계속 여기를 돌아다니고 있는데, 언제 끝날지 모르겠어요.."
        },
        {
          "speaker": "메모",
          "text": "끝이라.. 여긴 끝이 없어! 오히려 좋은 거 아니야?"
        },
        {
          "speaker": "V양",
          "text": "..."
        },
        {
          "speaker": "메모",
          "text": "에이, 표정 좀 풀어~"
        },
        {
          "speaker": "V양",
          "text": "후후, 그래도 전에 만난 분이 희망을 주셔서 좀 낫긴 해요."
        },
        {
          "speaker": "메모",
          "text": "아! 여기 오기 전에 만난 아저씨 말이지?"
        },
        {
          "speaker": "V양",
          "text": "네. 아시나요?"
        },
        {
          "speaker": "메모",
          "text": "알다마다. ..무섭긴 하지만."
        },
        {
          "speaker": "V양",
          "text": "무서운 분은 아니셨던데.."
        },
        {
          "speaker": "메모",
          "text": "네가 잘 몰라서 그래!"
        },
        {
          "speaker": "메모",
          "text": "어우. 그림 하나 잘못 건드렸다가.."
        },
        {
          "speaker": "메모",
          "text": "으.. 생각만 해도 등골이 오싹하네."
        },
        {
          "speaker": "V양",
          "text": "아, 그랬나요."
        },
        {
          "speaker": "메모",
          "text": "그래도 똑똑한 분이지 뭐! 저기 있는 것들도 다 그분이 도와주셨어!"
        },
        {
          "speaker": "V양",
          "text": "어떤 거요?"
        },
        {
          "speaker": "메모",
          "text": "파일들 말이야!"
        },
        {
          "speaker": "메모",
          "text": "안에 뭐가 들어 있다던데?"
        },
        {
          "speaker": "메모",
          "text": "사실 귀찮아서 열어보지도 않았어! 하하!"
        },
        {
          "speaker": "독백",
          "text": "음.. 한번 살펴볼 필요가 있겠어."
        },
        {
          "speaker": "메모",
          "text": "보고 싶으면 마음껏 봐!"
        },
        {
          "speaker": "V양",
          "text": "네, 그럴게요."
        },
        {
          "cmd": "setFlag",
          "flag": "restoreUnlocked"
        }
      ]
    },
    {
      "id": "S4_LOOP_1",
      "lines": [
        {
          "speaker": "메모",
          "text": "내 친구들 봤어?"
        },
        {
          "speaker": "V양",
          "text": "누구요?"
        },
        {
          "speaker": "메모",
          "text": "커서들 말이야!"
        },
        {
          "speaker": "V양",
          "text": "아, 네!"
        },
        {
          "speaker": "메모",
          "text": "난 걔네랑 그림 가지고 놀 때가 제일 재밌더라! 하하!"
        },
        {
          "speaker": "V양",
          "text": "안 그래도 그림을 오랫동안 돌려받지 못하셔서 기분이 안 좋아 보이시던데요."
        },
        {
          "speaker": "메모",
          "text": "사실 더 있었는데.."
        },
        {
          "speaker": "메모",
          "text": "우리가 잃어버렸지 뭐야~"
        },
        {
          "speaker": "V양",
          "text": "윽.. 그러면 안 되는 거 아니에요?"
        },
        {
          "speaker": "메모",
          "text": "그치만 그걸 이리저리 끌고 당기면서 노는 게 얼마나 재밌는데!"
        },
        {
          "speaker": "V양",
          "text": "그렇군요.. 그래도 누군가에게는 소중한 물건이지 않을까요?"
        },
        {
          "speaker": "메모",
          "text": "어차피 파일은 넘쳐나니까, 그렇게 중요한 건 아니잖아!"
        },
        {
          "speaker": "V양",
          "text": "..."
        }
      ]
    },
    {
      "id": "S4_LOOP_2",
      "lines": [
        {
          "speaker": "메모",
          "text": "아~ 다들 보고 싶다~~~"
        },
        {
          "speaker": "V양",
          "text": "에.. 그럼 만나러 가면 되는 거 아닌가요?"
        },
        {
          "speaker": "메모",
          "text": "응? 아니야~ 지금은 그럴 수 없어."
        },
        {
          "speaker": "V양",
          "text": "네..? 어째서요?"
        },
        {
          "speaker": "메모",
          "text": "음~ 언젠가는 다시 볼 수 있지 않을까? 하하!"
        },
        {
          "speaker": "V양",
          "text": "..그렇군요."
        }
      ]
    },
    {
      "id": "S4_LOOP_3",
      "lines": [
        {
          "speaker": "메모",
          "text": "어? 이제 가려고?"
        },
        {
          "speaker": "V양",
          "text": "네"
        },
        {
          "speaker": "메모",
          "text": "그렇구나~"
        },
        {
          "speaker": "메모",
          "text": "가는 길에 다른 친구들 만나면 안부 전해줘!"
        },
        {
          "speaker": "V양",
          "text": "다른 분들이 더 계시나요?"
        },
        {
          "speaker": "메모",
          "text": "당연하지!"
        },
        {
          "speaker": "V양",
          "text": "그렇군요. 만나면 꼭 안부 전해드릴게요."
        },
        {
          "speaker": "메모",
          "text": "응 조심히 가!"
        },
        {
          "speaker": "메모",
          "text": "그리고..."
        },
        {
          "speaker": "V양",
          "text": "네?"
        },
        {
          "speaker": "메모",
          "text": "아니야~ 잘 가라고 하하!"
        },
        {
          "speaker": "V양",
          "text": "..안녕히 계세요"
        }
      ]
    }
  ]
}