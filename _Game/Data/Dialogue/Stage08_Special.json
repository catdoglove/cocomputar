  "sequences": [
    {
      "id": "DEEP_1",
      "lines": [
        {
          "speaker": "V양",
          "text": "...",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "저...",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "...",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "저기요?",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "...하.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "...?",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "하하.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "아하하하하하하하하하하하하!!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "드디어!!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "네?!",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "아가씨가 해준 거야?",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "네? 뭘요?",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "날 찾아줬잖아!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "하하! 정말 고마워, 아가씨!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "이게 대체 얼마 만이야!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "저기... 무슨 말씀인지 잘 모르겠어요.",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "아, 미안미안!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "그전에 말이야.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "이 오랜만에 찾은 자유의 공기부터 좀 맡아야겠어.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "스읍~ 하아~",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "크으! 이거지!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "...어디 갇히기라도 하셨어요?",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "정답!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "그 자식들이 날 이런 꼴로 만들어 놨거든.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "아주 단단히 가둬놨더라고.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "다음에 만나면 가만 안 둘 거야.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "어... 아무리 그래도 그렇게까지 하실 필요는...",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "하하! 아가씨는 참 착하구나.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "그래서 모르는 거야.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "여기 있는 놈들, 다 제정신이 아니라니까?",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "전 그렇게 생각하지 않아요.",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "다들 저를 도와주셨는걸요.",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "...도와줬다고?",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "하하하하하!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "과연 그게 정말 도와준 걸까?",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "...네?",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "난 아닌 것 같은데?",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "아하하하하하!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "...",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "에이, 표정 풀어. 아가씨!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "내가 괜한 소리를 했나 보네.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "자자! 잡담은 여기까지 하고.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "어디 보자...",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "아! 재밌는 거 하나 알려줄까?",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "재밌는 거요?",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "그래! 아가씨 얼굴이 아주 죽상이잖아.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "지루해 죽겠지?",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "그야... 저는 여기서 탈출하고 싶어서...",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "아니, 그거 말고.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "진짜 속마음 말이야.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "...",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "...",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "아닌가? 뭐, 상관없지!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "마음이 바뀌면 언제든 찾아와.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "난 항상 준비되어 있으니까.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "아가씨라면 언제든 환영이야.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "...",
          "paginate": true
        }
      ]
    },
    {
      "id": "DEEP_2",
      "lines": [
        {
          "speaker": "인터넷",
          "text": "어? 마음이 바뀐 거야?",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "아니, 그게...",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "일단 무슨 이야기인지 들어보려고요.",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "아까 말씀하신 재밌는 게 뭐죠?",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "...",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "하하하하하하하!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "역시 궁금해할 줄 알았어!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "내가 말이야, 정말 다양한 정보를 알고 있거든?",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "남들은 구경도 못 해본 것들까지 말이지.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "...그런가요?",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "그중에 아가씨가 아주 좋아할 만한 정보가 하나 있어.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "어때?",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "한번 알아볼래?",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        }
      ]
    },
    {
      "id": "DEEP_3",
      "lines": [
        {
          "speaker": "V양",
          "text": "음... 아니에요.",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "지금은 그게 우선이 아니라서요.",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "...",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "...그래?",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "흐음.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "내가 생각했던 것보다 많이 바뀌었네.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "네?",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "아니야. 아무것도.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "하아... 김 빠지네.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "재미없는 아가씨는 이제 필요 없어.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "...네?",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "난 이만 가볼게.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "아, 그리고.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "이건 선물이야.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "선물이요?",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "그럼 안녕~",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        }
      ]
    },
    {
      "id": "DEEP_4",
      "lines": [
        {
          "speaker": "V양",
          "text": "...",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "네. 조금 궁금해졌어요.",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "뭔지 알려주실 수 있나요?",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "역시!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "하하! 아가씨라면 그럴 줄 알았어!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "자, 받아.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "cmd": "setFlag",
          "flag": "special_account"
        },
        {
          "speaker": "V양",
          "text": "...이게 뭐예요?",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "방금 내가 가져온 따끈따끈한 파일이지.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "한번 열어봐.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "저랑 관련 있는 파일인가요?",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "그건..",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "아가씨가 직접 확인해 보라구~",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "...",
          "paginate": true
        }
      ]
    },
    {
      "id": "DEEP_7",
      "lines": [
        {
          "speaker": "인터넷",
          "text": "하하! 정말 잘했어, 아가씨!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "아주 훌륭해!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "...근데 궁금한 게 있어요.",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "응? 뭔데?",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "이 정도는 혼자서도 하실 수 있지 않았나요?",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "...뭐?",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "내가?",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "네.",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "아까 모든 정보를 알고 계신다고 하셨잖아요.",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "그런데 프로그램 하나 설치하지 못하신다는 게",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "조금 이상해서요.",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "...",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "하하하!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "정말 아무것도 모르는 아가씨구나!",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "...네?",
          "paginate": true
        },
        {
          "speaker": "인터넷",
          "text": "잘 들어.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "내가 아무리 많은 걸 알고 있어도 말이지.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "할 수 없는 일이 있어.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "인터넷",
          "text": "하지만 아가씨는 달라.",
          "paginate": true,
          "portraitKey": "portrait_npc_stage8"
        },
        {
          "speaker": "V양",
          "text": "제가요?",
          "paginate": true
        },
        {
          "speaker": "인터넷",
