      "lines": [
        {
          "speaker": "조이스틱",
          "text": "왔다! 왔어!",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "네?",
          "paginate": true
        },
        {
          "speaker": "조이스틱",
          "text": "할 거지? 같이?",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "뭐를요?",
          "paginate": true
        },
        {
          "speaker": "조이스틱",
          "text": "전처럼! 게임!",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "어... 저는 게임을 해본 적이 없는데요.",
          "paginate": true
        },
        {
          "speaker": "조이스틱",
          "text": "아니야! 했어! 10년 전!",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "10년?!",
          "paginate": true
        },
        {
          "speaker": "조이스틱",
          "text": "같이하자! 헤헤.",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "저는 그럴 시간이 없어요.",
          "paginate": true
        },
        {
          "speaker": "V양",
          "text": "여기서 나가고 싶어요... 아시는 거 있나요?",
          "paginate": true
        },
        {
          "speaker": "조이스틱",
          "text": "...",
          "paginate": true
        },
        {
          "speaker": "조이스틱",
          "text": "안 돼.",
          "paginate": true
        },
        {
          "speaker": "조이스틱",
          "text": "나가는 건.",
